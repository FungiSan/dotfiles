#!/bin/bash

# A shortcut script for nwg-dock-hyprland, it has too much options
# and changing some option is a pain, you'll have to replace it in too many places

exit 0

if [[ "$MANGO_INSTANCE_SIGNATURE" ]]; then
  DOCK="dock-mango"
else
  DOCK="nwg-dock-hyprland"
fi

$DOCK \
  -p bottom \
  -d \
  -l top -hl bottom \
  -c "$HOME/.local/bin/toggle_rofi $HOME/.config/rofi/bin/drun --alternative" $@
